StringTable resource
{
	Entry _strings
	[
		{	String _name = "DSVillageSquareMeadBrewer";		String _text = "Медовар на деревенской площади";	}
		{	String _name = "DSVillageSquareMeadBrewerLwr";		String _text = "медовар на деревенской площади";	}
		{	String _name = "DSVillageSquareMeadBrewerTip";		String _text = "Медовар на деревенской площади — небольшое здание, где варят и подают медовуху и горячую медовуху. Медовуху делают из мёда и воды или из дикого мёда и воды. Для горячей медовухи нужны медовуха и лечебные травы. Нанимает 1 пивовара. Вместимость медовара в сумме 250. Для постройки требуется 55 ед. труда.";	}
		{	String _name = "DSVillageMeadery";		String _text = "Деревенская медоварня";	}
		{	String _name = "DSVillageMeaderyLwr";		String _text = "деревенская медоварня";	}
		{	String _name = "DSVillageMeaderyTip";		String _text = "Деревенская медоварня — таверна, где варят и подают горожанам медовуху и горячую медовуху. Медовуху делают из мёда и воды или из дикого мёда и воды. Для горячей медовухи нужны медовуха и лечебные травы. Нанимает 1-4 пивоваров. Медоварня хранит в сумме 600. Для постройки требуется 144 ед. труда.";	}
		{	String _name = "MeadWaterRequire";		String _text = "Медовуха (мёд: 40 + вода: 20)";	}
		{	String _name = "MeadWildHoneyWaterRequire";		String _text = "Медовуха (дикий мёд: 40 + вода: 20)";	}
		{	String _name = "MulledMeadRequire";		String _text = "Горячая медовуха (медовуха: 1 + лечебные травы: 1)";	}
		{	String _name = "DSVillageStorageShed2x2";		String _text = "Деревенский сарай - 2x2";	}
		{	String _name = "DSVillageStorageShed2x2Lwr";		String _text = "деревенский сарай";	}
		{	String _name = "DSVillageStorageShed2x2Tip";		String _text = "Деревенский сарай 2x2 — простое подсобное помещение для хранения всей пищи, лечебных трав и лекарств, инструментов, одежды, утвари и изделий. Общая вместимость 900. Для постройки требуется 21 ед. труда.";	}
		{	String _name = "DSVillageStorageShed2x3";		String _text = "Деревенский сарай - 2x3";	}
		{	String _name = "DSVillageStorageShed2x3Lwr";		String _text = "деревенский сарай";	}
		{	String _name = "DSVillageStorageShed2x3Tip";		String _text = "Деревенский сарай 2x3 — простое подсобное помещение для хранения всей пищи, лечебных трав и лекарств, инструментов, одежды, утвари и изделий. Общая вместимость 1250. Для постройки требуется 29 ед. труда.";	}
		{	String _name = "DSVillageBeehiveTrunks";		String _text = "Деревенские ульи";	}
		{	String _name = "DSVillageBeehiveTrunksLwr";		String _text = "деревенские ульи";	}
		{	String _name = "DSVillageBeehiveTrunksTip";		String _text = "На деревенских ульях пчеловод ухаживает за пчёлами и случайным образом собирает мёд, пчелиный воск и мёд в сотах. Нанимает 1 пчеловода. Для постройки требуется 34 ед. труда.";	}
		{	String _name = "DSVillageApiary";		String _text = "Деревенская пасека";	}
		{	String _name = "DSVillageApiaryLwr";		String _text = "деревенская пасека";	}
		{	String _name = "DSVillageApiaryTip";		String _text = "На деревенской пасеке пчеловоды ухаживают за пчёлами и случайным образом собирают мёд, пчелиный воск, мёд в сотах и маточное молочко. Нанимает 1-2 пчеловодов. Для постройки требуется 89 ед. труда.";	}
		{	String _name = "DSVillageApiaryProduce";		String _text = "Деревенская пасека";	}
		{	String _name = "DSVillageApiaryProduceLwr";		String _text = "деревенская пасека";	}
		{	String _name = "DSVillageApiaryProduceTip";		String _text = "На деревенской пасеке пчеловоды ухаживают за пчёлами и собирают либо мёд, либо мёд в сотах, либо пчелиный воск. Нанимает 1-2 пчеловодов. Для постройки требуется 89 ед. труда.";	}
		{	String _name = "HoneyRequire";		String _text = "Мёд";	}
		{	String _name = "CombHoneyRequire";		String _text = "Мёд в сотах";	}
		{	String _name = "BeeswaxRequire";		String _text = "Пчелиный воск";	}
		{	String _name = "DSVillageWaterWell";		String _text = "Деревенский колодец с водой";	}
		{	String _name = "DSVillageWaterWellLwr";		String _text = "деревенский колодец с водой";	}
		{	String _name = "DSVillageWaterWellTip";		String _text = "Деревенский колодец: рабочий достаёт из колодца воду, которую горожане пьют (съедобное) или используют как ингредиент. Нанимает 1 рабочего. Для постройки требуется 55 ед. труда.";	}
		{	String _name = "DSVillageMeaderyTables";		String _text = "Стол деревенской медоварни";	}
