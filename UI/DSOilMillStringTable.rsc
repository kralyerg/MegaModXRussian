		{	String _name = "DSOilMillProductTip";		String _text = "Выберите масло, которое будет отжиматься в этом здании. Растительное масло — съедобная пища, его потребляют горожане. Льняное и лампадное масло — утварь. Числа перед названием продукта — выпуск необразованных и образованных работников, исходные ресурсы указаны в (скобках) вместе с нужным количеством.";	}
		{	String _name = "DSOilMillMineProductTip";		String _text = "Выберите продукт для начала добычи. Числа перед названием продукта — выпуск необразованных и образованных работников, исходные ресурсы указаны в (скобках) вместе с нужным количеством.";	}
