		{	String _name = "DSFulbertWrightHousingMenuTip";		String _text = "Жильё от Фулбера и семьи, мастеров по строительству жилья и плотницкому делу. Каждый тип дома можно построить в вариантах с поворотом по клавише F (0, 13, 21, 34, 326, 359, 367°). ВНИМАНИЕ: дома с поворотом позволяют жителям проходить сквозь стены.";	}
		{	String _name = "DSFWHs01";		String _text = "Маленький дом - тип 01";	}
