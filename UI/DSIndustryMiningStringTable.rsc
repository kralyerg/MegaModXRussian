		{	String _name = "DSThaddSurrelFlaxFarmer";		String _text = "Промышленная льняная ферма Тэдда Суррела и семьи - посадочное здание для посева семян и ухода за растениями и уборочное здание для сбора льна.";	}
		{	String _name = "DSThaddSurrelFlaxFarmerPlanter";		String _text = "Льняная ферма: посадка";	}
		{	String _name = "DSThaddSurrelFlaxFarmerPlanterLwr";		String _text = "льняная ферма, посадка";	}
		{	String _name = "DSThaddSurrelFlaxFarmerPlanterTip";		String _text = "Посадочное здание льняной фермы Тэдда Суррела и семьи, для строительства нужно льняное семя; 1-3 фермера сажают и выращивают лён. Для строительства требуется 34 ед. труда.";	}
		{	String _name = "DSThaddSurrelFlaxFarmerHarvester";		String _text = "Льняная ферма: уборка";	}
		{	String _name = "DSThaddSurrelFlaxFarmerHarvesterLwr";		String _text = "льняная ферма, уборка";	}
		{	String _name = "DSThaddSurrelFlaxFarmerHarvesterTip";		String _text = "Уборочное здание льняной фермы Тэдда Суррела и семьи, 1-3 фермера собирают лён. Для строительства требуется 21 ед. труда.";	}
		{	String _name = "DSThaddSurrelPressShed";		String _text = "Тэдд Суррел и семья: пресс-сарай";	}
		{	String _name = "DSThaddSurrelPressShedLwr";		String _text = "пресс-сарай";	}
		{	String _name = "DSThaddSurrelPressShedTip";		String _text = "Пресс-сарай Тэдда Суррела и семьи, где работник делает либо масло для ламп, либо съедобное растительное масло из миндаля, каштанов, фундука, пекана или грецких орехов. Для строительства требуется 34 ед. труда.";	}
		{	String _name = "DSCoalBellPit1";		String _text = "Колокольная угольная яма";	}
		{	String _name = "DSCoalBellPit1Lwr";		String _text = "колокольная угольная яма";	}
		{	String _name = "DSCoalBellPit1Tip";		String _text = "Примитивная угольная шахта, строится на ровной земле, нанимает 3-8 шахтёров, которые добывают только уголь из колоколообразной ямы в земле. Добыча ограничена 600, после истощения шахту нужно улучшить, чтобы она продолжила работу. Для строительства требуется 34 ед. труда.";	}
		{	String _name = "DSCoalBellPit1Upgrade";		String _text = "Колокольная угольная шахта";	}
		{	String _name = "DSCoalBellPit1UpgradeLwr";		String _text = "колокольная угольная шахта";	}
		{	String _name = "DSCoalBellPit1UpgradeTip";		String _text = "Улучшите колоколообразную яму, чтобы продлить добычу ещё на 5,400 и немного ускорить добычу угля благодаря блочной системе, помогающей шахтёрам (до 13 шахтёров). Для улучшения требуется 89 ед. труда.";	}
		{	String _name = "DSSmallIronOreMine";		String _text = "Малая железорудная шахта";	}
		{	String _name = "DSSmallIronOreMineLwr";		String _text = "малая железорудная шахта";	}
		{	String _name = "DSSmallIronOreMineTip";		String _text = "Небольшая горная шахта, где 1-13 шахтёров добывают только железную руду. Добыча ограничена 1,200, но шахту можно улучшить, чтобы она продолжила работу. Для строительства входа в шахту требуется 21 ед. труда. Недорогая шахта, но для максимальной добычи её нужно поставить в идеальное место, а шахту может быть трудно разместить, не сдавайтесь.";	}
		{	String _name = "DSSmallIronOreMineUpgradeOilLamps";		String _text = "Железорудная шахта";	}
		{	String _name = "DSSmallIronOreMineUpgradeOilLampsLwr";		String _text = "железорудная шахта";	}
		{	String _name = "DSSmallIronOreMineUpgradeOilLampsTip";		String _text = "Улучшение продлевает срок службы до 24,800 и немного ускоряет добычу железной руды, при этом можно нанять до 21 шахтёра. Для улучшения требуется 89 ед. труда";	}
		{	String _name = "ImprovedMine";		String _text = "Улучшенная шахта";	}
		{	String _name = "ImprovedMineLwr";		String _text = "улучшенная шахта";	}
		{	String _name = "ImprovedMineTip";		String _text = "Модель улучшенной шахты, созданная совместно с Яндерсеном. Это горная шахта, где 1-30 шахтёров добывают железную руду, медную руду или уголь. Добыча ограничена 21,000. Для строительства требуется 144 ед. труда.";	}
		{	String _name = "DSThaddSurrelMineOilLamps";		String _text = "Тэдд Суррел и семья: промышленная шахта";	}
		{	String _name = "DSThaddSurrelMineOilLampsLwr";		String _text = "промышленная шахта";	}
		{	String _name = "DSThaddSurrelMineOilLampsTip";		String _text = "Промышленная шахта Тэдда Суррела и семьи. Добывает железную, медную, оловянную руду или уголь, для работы нужны доски и либо масло для ламп, либо свечи. Нанимает 1-55 шахтёров. Общая добыча шахты за весь срок службы составляет 250,000. Для строительства требуется 233 ед. труда.";	}
		{	String _name = "DSIndustryMineSecond";		String _text = "Тэдд Суррел и семья: вторая промышленная шахта";	}
		{	String _name = "DSIndustryMineSecondLwr";		String _text = "вторая промышленная шахта";	}
		{	String _name = "DSIndustryMineSecondTip";		String _text = "Большая вторая промышленная шахта Тэдда Суррела и семьи. Добывает железную, медную, оловянную руду или уголь, для работы нужны доски и либо масло для ламп, либо свечи. Нанимает 1-72 шахтёров. Добыча шахты почти неисчерпаема: 5,000,000 за весь срок службы. Для строительства требуется 512 ед. труда.";	}
		{	String _name = "DSClarenceSilverMine01";		String _text = "Серебряная шахта Кларенса, 1-я звезда";	}
		{	String _name = "DSClarenceSilverMine01Lwr";		String _text = "серебряная шахта Кларенса";	}
		{	String _name = "DSClarenceSilverMine01Tip";		String _text = "Серебряная шахта Кларенса - большая шахта серебряной руды, первая ступень на уровне 1-й звезды. Нанимает 1-8 шахтёров, для работы нужны доски и 2 ед. масла для ламп. Добыча ограничена, затем шахту нужно улучшить, чтобы продолжить добычу серебряной руды. Для строительства требуется 89 ед. труда.";	}
		{	String _name = "DSClarenceSilverMine02";		String _text = "Серебряная шахта Кларенса, 2-я звезда";	}
		{	String _name = "DSClarenceSilverMine02Lwr";		String _text = "серебряная шахта Кларенса";	}
		{	String _name = "DSClarenceSilverMine02Tip";		String _text = "Улучшите шахту, расширив заднюю сортировочную, чтобы освободить место для более широкого входа в шахту. Существующие туннели будут укреплены, чтобы выдержать немного больший штат шахтёров: 13. Улучшенная шахта даст в сумме 610 до следующего улучшения. Для строительства требуется 144 ед. труда.";	}
		{	String _name = "DSClarenceSilverMine03";		String _text = "Серебряная шахта Кларенса, 3-я звезда";	}
		{	String _name = "DSClarenceSilverMine03Lwr";		String _text = "серебряная шахта Кларенса";	}
		{	String _name = "DSClarenceSilverMine03Tip";		String _text = "Улучшив шахту, вы добавите большую верхнюю блочную систему, которая позволит копать глубже и добывать быстрее, так как блоки упрощают подъём тяжёлой руды на поверхность. В шахте можно нанять до 21 шахтёра. Улучшенная шахта даст в сумме 1,597 до следующего улучшения. Для строительства требуется 233 ед. труда.";	}
		{	String _name = "DSClarenceSilverMine04";		String _text = "Серебряная шахта Кларенса, 4-я звезда";	}
		{	String _name = "DSClarenceSilverMine04Lwr";		String _text = "серебряная шахта Кларенса";	}
		{	String _name = "DSClarenceSilverMine04Tip";		String _text = "Улучшите и усильте блочную систему, добавив ещё один блок! Добыча снова ускоряется, а шахта теперь может нанять до 34 шахтёров. Но это ещё не всё: освещение шахты тоже улучшается, отдача растёт, и теперь шахтёрам требуется всего 1 ед. масла для ламп. Улучшенная шахта даст в сумме 4,181 до следующего улучшения. Для строительства требуется 377 ед. труда.";	}
		{	String _name = "DSClarenceSilverMine05";		String _text = "Серебряная шахта Кларенса, 5-я звезда";	}
		{	String _name = "DSClarenceSilverMine05Lwr";		String _text = "серебряная шахта Кларенса";	}
		{	String _name = "DSClarenceSilverMine05Tip";		String _text = "Улучшив шахту, вы проложите рельсовые пути, по которым смогут ездить более быстрые тележки, что повысит скорость добычи. Это последний уровень глубины шахты, после которого вся серебряная руда будет исчерпана. Общая вместимость 10,946. Для строительства требуется 610 ед. труда.";	}
		{	String _name = "UpgradeClarenceSilverMine01Txt";		String _text = "улучшите шахту после истощения:";	}
		{	String _name = "DSPlacerMine01";		String _text = "Прибрежная шахта";	}
		{	String _name = "DSPlacerMine01Lwr";		String _text = "прибрежной шахты";	}
		{	String _name = "DSPlacerMine01Tip";		String _text = "Россыпная шахта добывает оловянную руду и золото из берега водоёма. Нанимает 1-4 шахтёров. Добыча за весь срок службы велика: 13,000. Для строительства требуется 84 ед. труда.";	}
		{	String _name = "DSIndustrialQuarry";		String _text = "Промышленный карьер";	}
		{	String _name = "DSIndustrialQuarryLwr";		String _text = "промышленный карьер";	}
		{	String _name = "DSIndustrialQuarryTip";		String _text = "Промышленный карьер для добычи и обработки камня. Для работы нужны инструменты каменотёса (Инструменты: каменотёс), которые можно сделать у кузнеца. Нанимает 1-34 каменотёсов. Добыча карьера велика: 200,000 за весь срок службы. Для строительства требуется 144 ед. труда.";	}
		{	String _name = "DSCokeOvenMenuTip";		String _text = "Батарейные коксовые и известковые печи. Модульная постройка, перерабатывает уголь в кокс или камень в известь.";	}
		{	String _name = "DSCokeOven1";		String _text = "Батарейная коксовая печь";	}
		{	String _name = "DSCokeOven1Lwr";		String _text = "коксовая печь";	}
		{	String _name = "DSCokeOven1Tip";		String _text = "Используйте печь, чтобы «обжигать» уголь, удаляя примеси, что даёт более жаркое и сильное тепло в виде кокса. Для строительства требуется 55 ед. труда. Варианты по клавише F.";	}
		{	String _name = "DSCokeOven1Lime";		String _text = "Батарейная известковая печь";	}
		{	String _name = "DSCokeOven1LimeLwr";		String _text = "известковая печь";	}
		{	String _name = "DSCokeOven1LimeTip";		String _text = "Известковая печь перерабатывает камень в известь (также известную как негашёная известь). Известь используется при выплавке железа, а также как строительный материал (раствор и штукатурка). Для строительства требуется 55 ед. труда.";	}
		{	String _name = "DSCokeOven1rampL";		String _text = "Левый пандус";	}
		{	String _name = "DSCokeOven1rampLLwr";		String _text = "левый пандус";	}
		{	String _name = "DSCokeOven1rampLTip";		String _text = "Добавьте торцевой пандус к батарейным печам, чтобы было проще подняться на верх печи. Для строительства требуется 13 ед. труда.";	}
		{	String _name = "DSCokeOven1rampR";		String _text = "Правый пандус";	}
		{	String _name = "DSCokeOven1rampRLwr";		String _text = "правый пандус";	}
		{	String _name = "DSCokeOven1rampRTip";		String _text = "Добавьте торцевой пандус к батарейным печам, чтобы было проще подняться на верх печи. Для строительства требуется 13 ед. труда.";	}
		{	String _name = "DSCokeOven1ladder";		String _text = "Лестница";	}
		{	String _name = "DSCokeOven1ladderLwr";		String _text = "лестница";	}
		{	String _name = "DSCokeOven1ladderTip";		String _text = "Добавьте лестницу к батарейным печам, чтобы было проще подняться на верх печи. Для строительства требуется 13 ед. труда.";	}
		{	String _name = "DSCokeOven1pt1x4";		String _text = "Удлинение стены";	}
		{	String _name = "DSCokeOven1pt1x4Lwr";		String _text = "удлинение стены";	}
		{	String _name = "DSCokeOven1pt1x4Tip";		String _text = "Добавьте удлинение стены к батарейным печам, 1x4. Для строительства требуется 5 ед. труда.";	}
		{	String _name = "DSCokeOven1pt1x1";		String _text = "Торцевая стена";	}
		{	String _name = "DSCokeOven1pt1x1Lwr";		String _text = "торцевая стена";	}
		{	String _name = "DSCokeOven1pt1x1Tip";		String _text = "Добавьте торцевые элементы стены к батарейным печам, это непроходимый участок. Для строительства требуется 3 ед. труда. Варианты по клавише F.";	}
		{	String _name = "DSCokeOven1rampShortL";		String _text = "Короткий левый пандус";	}
		{	String _name = "DSCokeOven1rampShortLLwr";		String _text = "левый пандус";	}
		{	String _name = "DSCokeOven1rampShortLTip";		String _text = "Добавьте короткий торцевой пандус к батарейным печам, чтобы было проще подняться на верх печи. Для строительства требуется 5 ед. труда.";	}
		{	String _name = "DSCokeOven1rampShortR";		String _text = "Короткий правый пандус";	}
		{	String _name = "DSCokeOven1rampShortRLwr";		String _text = "правый пандус";	}
		{	String _name = "DSCokeOven1rampShortRTip";		String _text = "Добавьте короткий торцевой пандус к батарейным печам, чтобы было проще подняться на верх печи. Для строительства требуется 5 ед. труда.";	}
		{	String _name = "DSWorkersConstructionYard";		String _text = "Строительный двор рабочих";	}
		{	String _name = "DSWorkersConstructionYardLwr";		String _text = "строительный двор рабочих";	}
		{	String _name = "DSWorkersConstructionYardTip";		String _text = "Идеален в начале игры: производит многие нужные строительные материалы, помогающие расширять деревню. Производит доски, железную фурнитуру, кирпичи, черепицу, известь или стекло. Следите за запасами необходимых брёвен, железа, древесного угля, камня, глины и песка. Для строительства требуется 34 ед. труда. На карте можно построить только 2.";	}
		{	String _name = "DSBlacksmith01";		String _text = "Кузнец";	}
		{	String _name = "DSBlacksmith01Lwr";		String _text = "кузницы";	}
		{	String _name = "DSBlacksmith01Tip";		String _text = "Эта кузница может производить инструменты, железную фурнитуру, наковальни и детали повозок. Для работы требуется металлургическое топливо. Для строительства требуется 89 ед. труда.";	}
		{	String _name = "DSThaddSurrelBlacksmith";		String _text = "Тэдд Суррел и семья: кузница";	}
		{	String _name = "DSThaddSurrelBlacksmithLwr";		String _text = "промышленная кузница";	}
		{	String _name = "DSThaddSurrelBlacksmithTip";		String _text = "Кузница Тэдда Суррела и семьи производит инструменты, железную фурнитуру, наковальни и детали повозок. Для работы требуется металлургическое топливо. Для строительства требуется 89 ед. труда.";	}
		{	String _name = "DSThaddSurrelTinsmith";		String _text = "Тэдд Суррел и семья: мастерская жестянщика";	}
		{	String _name = "DSThaddSurrelTinsmithLwr";		String _text = "промышленная мастерская жестянщика";	}
		{	String _name = "DSThaddSurrelTinsmithTip";		String _text = "Мастерская жестянщика Тэдда Суррела и семьи производит оловянную посуду. Для строительства требуется 89 ед. труда.";	}
		{	String _name = "DSIndustryWoodChopper";		String _text = "Дровокол";	}
		{	String _name = "DSIndustryWoodChopperLwr";		String _text = "дровокол";	}
		{	String _name = "DSIndustryWoodChopperTip";		String _text = "1 дровосек рубит брёвна или доски на дрова. Для строительства требуется 8 ед. труда.";	}
		{	String _name = "DSThaddSurrelLumbermill";		String _text = "Тэдд Суррел и семья: лесопилка";	}
		{	String _name = "DSThaddSurrelLumbermillLwr";		String _text = "промышленная лесопилка";	}
		{	String _name = "DSThaddSurrelLumbermillTip";		String _text = "Лесопилка Тэдда Суррела и семьи, 1-5 дровосеков управляют лесопилкой, перерабатывая брёвна в доски или дрова. Для строительства требуется 144 ед. труда.";	}
		{	String _name = "DSWaterPowerFurnace";		String _text = "Доменная печь на водяном приводе";	}
		{	String _name = "DSWaterPowerFurnaceLwr";		String _text = "доменная печь";	}
		{	String _name = "DSWaterPowerFurnaceTip";		String _text = "Требует постройки рядом с ручьём или рекой. Благодаря высоким температурам и мощному потоку воздуха эта доменная печь - отличное дополнение к промышленному поселению. Водяной привод вращает большие мехи, нагнетающие воздух в печь. Печь способна перерабатывать большие объёмы железной руды в железо, медной руды в медь, оловянной руды в олово, а медной и оловянной руд в бронзу с помощью металлургического топлива (кокса или древесного угля). Нанимает 1-8 кузнецов. Для строительства здания требуется 233 ед. труда.";	}
		{	String _name = "DSBlastFurnace";		String _text = "Тэдд Суррел и семья: доменная печь";	}
		{	String _name = "DSBlastFurnaceLwr";		String _text = "доменная печь";	}
		{	String _name = "DSBlastFurnaceTip";		String _text = "Эту доменную печь можно построить на ровной земле, а высоких температур она достигает благодаря медной паровой машине, приводящей в движение мехи. Печь - отличное дополнение к промышленному поселению. Способна перерабатывать большие объёмы железной руды в железо, медной руды в медь, оловянной руды в олово, а медной и оловянной руд в бронзу с помощью металлургического топлива (кокса или древесного угля). Нанимает 1-6 кузнецов. Для строительства здания требуется 233 ед. труда. Варианты по клавише F.";	}
		{	String _name = "DSHillLimeKiln";		String _text = "Известковая печь на холме";	}
		{	String _name = "DSHillLimeKilnLwr";		String _text = "известковая печь на холме";	}
		{	String _name = "DSHillLimeKilnTip";		String _text = "Известковая печь на холме перерабатывает камень в известь (также известную как негашёная известь). Известь используется при выплавке железа, а также как строительный материал (раствор и штукатурка). Для строительства требуется 89 ед. труда. Нужно строить вплотную к холму или горе.";	}
		{	String _name = "DSSilverFineryFurnace";		String _text = "Печь для рафинирования серебра";	}
		{	String _name = "DSSilverFineryFurnaceLwr";		String _text = "печь для рафинирования серебра";	}
		{	String _name = "DSSilverFineryFurnaceTip";		String _text = "Печь для рафинирования серебра перерабатывает серебряную руду в серебро. Для работы требуется металлургическое топливо. Нанимает 1 кузнеца. Для строительства требуется 89 ед. труда.";	}
		{	String _name = "DSThaddSurrelCoinTradingPost";		String _text = "Тэдд Суррел и семья: торговец, закупочная контора";	}
		{	String _name = "DSThaddSurrelCoinTradingPostLwr";		String _text = "промышленный торговец";	}
		{	String _name = "DSThaddSurrelCoinTradingPostTip";		String _text = "Закупочная контора позволяет покупать любые товары за монеты, золото и серебро. Регулярно приезжают семь разных купцов, привозящих все ресурсы, один из них торгует семенами. Однако пастбищных животных здесь купить нельзя. Для строительства торговца требуется 144 ед. труда.";	}
		{	String _name = "DSThaddSurrelTradingPost";		String _text = "Тэдд Суррел и семья: торговец, скупщик товаров";	}
		{	String _name = "DSThaddSurrelTradingPostLwr";		String _text = "промышленный торговец";	}
		{	String _name = "DSThaddSurrelTradingPostTip";		String _text = "Скупщика товаров регулярно посещает купец Торговой гильдии, он покупает у вас все ресурсы за монеты, золото и серебро. Для строительства купца требуется 233 ед. труда.";	}
