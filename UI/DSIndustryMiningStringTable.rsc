		{	String _name = "DSThaddSurrelFlaxLinenWeaverTip";		String _text = "Льноткацкая мастерская Тэдда Суррела и семьи производит льняную ткань из льна, а льняное семя собирается как побочный продукт. Нанимает 1-3 ткачей. Для строительства требуется 89 ед. труда.";	}
		{	String _name = "DSThaddSurrelCandlemaker";		String _text = "Тэдд Суррел и семья: свечная мастерская";	}
