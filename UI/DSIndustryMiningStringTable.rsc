		{	String _name = "DSThaddSurrelCandlemakerTip";		String _text = "Свечная мастерская Тэдда Суррела и семьи производит свечи из пчелиного воска или жира. Для строительства требуется 55 ед. труда.";	}
		{	String _name = "DSThaddSurrelOilKiln";		String _text = "Тэдд Суррел и семья: масляная печь";	}
		{	String _name = "DSThaddSurrelOilKilnLwr";		String _text = "промышленная масляная печь";	}
		{	String _name = "DSThaddSurrelOilKilnTip";		String _text = "Масляная печь Тэдда Суррела и семьи производит масло для ламп из орехов, льняного семени и жира. Благодаря нагреву при извлечении масла печь работает быстрее обычных прессов, но не может делать съедобное масло. Нанимает 1-2 работников. Для строительства требуется 89 ед. труда.";	}
		{	String _name = "DSThaddSurrelPotterykiln";		String _text = "Тэдд Суррел и семья: гончарная печь";	}
