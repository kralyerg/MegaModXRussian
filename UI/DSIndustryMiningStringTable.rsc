		{	String _name = "DSThaddSurrelPotterykilnTip";		String _text = "Гончарная печь Тэдда Суррела и семьи, гончар делает керамику из глины или из песка и извести. Печи для работы нужно топливо. Для строительства требуется 55 ед. труда.";	}
		{	String _name = "DSRailCartsSmallMenu";		String _text = "Малая рельсовая тележка для хранения, рельсовые пути проложены под тележкой";	}
