StringTable startConditions
{
	Entry _strings
	[
		{	String _name = "Easy0Name";		String _text = "Промышленность: инструменты";	}
		{	String _name = "Easy0Desc";		String _text = "Лёгкая игра: начинается с пяти семей и домов. Выдаётся большое количество одежды, пищи, дров, древесного угля, инструментов, брёвен, железа и камня. Амбары Тадд Суррел уже построены, а также кузница Тадд Суррел, кузнечный горн и точило. Есть немного семян для полей и садов, а также стадо скота.";	}
		{	String _name = "Easy2Name";		String _text = "Промышленность: лён, полотно и масло для ламп";	}
