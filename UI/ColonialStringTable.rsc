		{	String _name = "LlamaEasyName";		String _text = "[CC] Проклятие золотой ламы (Легко)";	}
		{	String _name = "LlamaEasyDesc";		String _text = "Проклятие Золотой Ламы - мистическая составляющая мира Banished. Что такое 'Золотая Лама'? Какие тайны она хранит? Отважитесь ли Вы изучить её тёмные стороны? Начальные условия аналогичны уровню легко, однако добавлена функция приключений, наградой за которые могут быть сокровища.";	}

		{	String _name = "LlamaMediumName";		String _text = "[CC] Проклятие золотой ламы (Средне)";	}
		{	String _name = "LlamaMediumDesc";		String _text = "Проклятие Золотой Ламы - мистическая составляющая мира Banished. Что такое 'Золотая Лама'? Какие тайны она хранит? Отважитесь ли Вы изучить её тёмные стороны? Начальные условия аналогичны уровню средне, однако добавлена функция приключений, наградой за которые могут быть сокровища.";	}

		{	String _name = "LlamaHardName";		String _text = "[CC] Проклятие золотой ламы (Трудно)";	}
		{	String _name = "LlamaHardDesc";		String _text = "Проклятие Золотой Ламы - мистическая составляющая мира Banished. Что такое 'Золотая Лама'? Какие тайны она хранит? Отважитесь ли Вы изучить её тёмные стороны? Начальные условия аналогичны уровню трудно, однако добавлена функция приключений, наградой за которые могут быть сокровища.";	}

		{	String _name = "LlamaAEName";		String _text = "[CC] Проклятие золотой ламы (Адам и Ева)";	}
		{	String _name = "LlamaAEDesc";		String _text = "Проклятие Золотой Ламы - мистическая составляющая мира Banished. Что такое 'Золотая Лама'? Какие тайны она хранит? Отважитесь ли Вы изучить её тёмные стороны? Начальные условия аналогичны уровню Адам и Ева, однако добавлена функция приключений, наградой за которые могут быть сокровища.";	}

		{	String _name = "OldCastleHardName";		String _text = "[CC] Старинный замок (Трудно)";	}
		{	String _name = "OldCastleHardDesc";		String _text = "Начните игру на месте старого замка, который теперь можно использовать как амбар. Жители уже запасли консервы, одежду, орудий и дрова в небольшом количестве. Жители не прихватили ни семена, ни животных.";	}

		{	String _name = "BayouEasyName";		String _text = "[CC] Байу (Легко)";	}
		{	String _name = "BayouEasyDesc";		String _text = "Байу - часть реки, в которой очень медленное течение, что отлично подходит для строительства города на воде! Жители уже построили дома, амбар и склад, в которых запасли некоторое количество риса, одежды, яиц, орудий и строительных материалов. Рядом с поселением Вы найдёте кур.";	}

		{	String _name = "PlainsEasyName";		String _text = "Равнины (Легко)";	}
		{	String _name = "PlainsEasyDesc";		String _text = "Тест";	}

		{	String _name = "FantasyEasyName";		String _text = "[CC] На всём своём (Легко)";	}
		{	String _name = "FantasyEasyDesc";		String _text = "По всей земле разбросаны различные виды пищи, которую можно собрать. Камни и железо - возобновляемый ресурс, который периодически появляется на карте. Такие начальные условия делают игру чрезвычайно простой и нереальной из-за обилия природных ресурсов.";	}

		{	String _name = "FantasyAEName";		String _text = "[CC] На всём своём (Адам и Ева)";	}
		{	String _name = "FantasyAEDesc";		String _text = "По всей земле разбросаны различные виды пищи, которую можно собрать. Камни и железо - возобновляемый ресурс, который периодически появляется на карте. Такие начальные условия делают игру чрезвычайно простой и нереальной из-за обилия природных ресурсов. В начале этой игры в Вашем распоряжении только 2 человека.";	}

		{	String _name = "ShipwreckHardName";		String _text = "[CC] Кораблекрушение (Трудно)";	}
		{	String _name = "ShipwreckHardDesc";		String _text = "После кораблекрушения Вы оказываетесь на незнакомой земле. У Ваших людей есть только ум и то, что они могут спасти при крушении.";	}

		{	String _name = "ShipwreckElDoradoHardName";		String _text = "[CC] Кораблекрушение (Эльдорадо, Трудно)";	}
		{	String _name = "ShipwreckElDoradoHardDesc";		String _text = "После кораблекрушения Вы оказываетесь на незнакомой земле, на которой растут только новые деревья. У Ваших людей есть только ум и то, что они могут спасти при крушении.";	}

