		{	String _name = "AbandonedJungleHardName";		String _text = "[CC] Заброшенная деревня (Джунгли)";	}
		{	String _name = "AbandonedJungleHardDesc";		String _text = "Глубоко в джунглях Ваши люди наткнулись на остатки предыдущего поселения. Вам доступно такое же количество ресурсов, как и в стандартной трудной игре, однако некоторые дома уже построены, другие - лишь частично.";	}

