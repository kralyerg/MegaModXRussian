		{	String _name = "StitcherTip";		String _text = "Военный портной специализируется на пошиве красочной одежды для военных, которая поднимает боевой дух солдат, поэтому имеет важное значение для военной силы. В то время как портные в ателье могут сшить ливрею из шёлка и канифаса, военный портной, создающий исключительно ливреи, может сшить их из различных ресурсов.";	}
		
		{	String _name = "Quartermaster";		String _text = "Штаб интенданта";	}
