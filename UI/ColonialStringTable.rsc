		{	String _name = "CCAdamEve";		String _text = "[CC] Адам и Ева";	}
		{	String _name = "CCAdamEveDesc";		String _text = "В начале игре в Вашем распоряжении 2 человека. В телеге, с которой они пришли, есть скудные запасы пищи, дров, одежды и орудий, однако ни скот, ни семена они с собой не прихватили. Рекомендуется опытным игрокам.";	}

		{	String _name = "CCSilkRoad";		String _text = "[CC] Шёлковый путь (Легко)";	}
		{	String _name = "CCSilkRoadDesc";		String _text = "Начните производство шёлка с помощью построенных фермы шелкопрядов и ткацкой мастерской! В начале игры в Вашем распоряжении 6 семей. Жители уже построили 6 деревянных домов, амбар, склад, ферму шелкопрядов, ткацкую мастерскую и выделили область для сада. В амбаре и на складе есть значительные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и семена белой шелковицы для сада.";	}
		
		{	String _name = "CCSilkRoadMed";		String _text = "[CC] Шёлковый путь (Средне)";	}
		{	String _name = "CCSilkRoadMedDesc";		String _text = "Начните производство шёлка с помощью построенных фермы шелкопрядов и ткацкой мастерской! В начале игры в Вашем распоряжении 5 семей. Жители уже построили амбар, склад, ферма шелкопрядов, ткацкая мастерская и выделили область для сада. В амбаре и на складе есть удовлетворительные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и семена белой шелковицы для сада.";	}

		{	String _name = "CCSilkRoadHard";		String _text = "[CC] Шёлковый путь (Трудно)";	}
		{	String _name = "CCSilkRoadHardDesc";		String _text = "Начните производство шёлка с помощью построенных фермы шелкопрядов и ткацкой мастерской! В начале игры в Вашем распоряжении 4 семьи. В телеге, с которой они пришли, есть скудные запасы одежды, пищи, дров и орудий. Кроме того, жители прихватили семена белой шелковицы для сада.";	}
		
		{	String _name = "CCMine";		String _text = "[CC] Шахта";	}

		{	String _name = "CCMineDesc";		String _text = "Уникальная шахта для ценных вещей.";	}

		{	String _name = "CCMediumPlus";		String _text = "[CC] Средне+";	}
		{	String _name = "CCMediumPlusDesc";		String _text = "В начале игры в Вашем распоряжении 5 семей. Жители уже построили амбар и склад, на которых есть удовлетворительные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и садов, а также стадо животных.";	}
		
		{	String _name = "CCMissionary";		String _text = "[CC] Миссионерство";	}
		{	String _name = "CCMissionaryDesc";		String _text = "В начале игры в Вашем распоряжении 3 семьи, 2 из которых необразованные. Жители уже построили 2 дома, приходской дом и склад. В телеге, с которой они пришли есть скудные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и садов, а также стадо животных.";	}
		
		{	String _name = "CCFort";		String _text = "[CC] Новый рубеж";	}
		{	String _name = "CCFortDesc";		String _text = "Эта игра начинается с заставы, построенной рядом с дружеским поселением индейцев. Защищайте и обучайте своих граждан, и легенды о Вас ещё долго будут ходить на западе. В начале игры в Вашем распоряжении 3 семьи. Жители уже построили форт и 2 бревенчатых дома. В телеге, с которой они пришли, есть скудные запасы одежды, пищи, дров и орудий, а на складе - строительных материалов. Кроме того, жители прихватили стадо животных и какие-то семена для полей и садов. Также для исследования доступна священная земля, где можно найти очень ценные предметы. Разумеется, если Вам не страшна кара местных богов...";	}

		{	String _name = "CCFortHard";		String _text = "[CC] Коренное поселение (Трудно)";	}
		{	String _name = "CCFortHardDesc";		String _text = "Для этой игры требуются хорошие отношения с племенем, живущим в этой области, поэтому начало достаточно трудное. Поселению индейцев нужны ресурсы, отдавая которые Вы покажете, что пришли с миром. В свою очередь, Вы получите возможность взаимодействовать с постройками. Как иноземец, Вам предстоит многому научиться, чтобы нажить союзников, а не врагов.";	}

		{	String _name = "CCFortAE";		String _text = "[CC] Коренное поселение (Адам и Ева)";	}
		{	String _name = "CCFortAEDesc";		String _text = "В начале игре в Вашем распоряжении 2 человека. В телеге, с которой они пришли, есть скудные запасы пищи, дров, одежды и орудий Для этой игры требуются хорошие отношения с племенем, живущим в этой области, поэтому начало достаточно трудное. Поселению индейцев нужны ресурсы, отдавая которые Вы покажете, что пришли с миром. В свою очередь, Вы получите возможность взаимодействовать с постройками. Как иноземец, Вам предстоит многому научиться, чтобы нажить союзников, а не врагов.";	}

