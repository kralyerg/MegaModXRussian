StringTable resource
{
	Entry _strings
	[ 
		{	String _name = "DSStythTowerMenuTip";		String _text = "Башни Стайта - сторожевые башни для вашего города. Когда в них работают, они выдают случайный набор товаров, конфискуя краденое у тех, кого мы можем лишь предполагать: бандитов? или пришельцев...";	}
	
		{	String _name = "DSStythTower";		String _text = "Башня Стайта";	}
		{	String _name = "DSStythTowerLwr";		String _text = "башня Стайта";	}
		{	String _name = "DSStythTowerTip";		String _text = "Башня Стайта, первоначальная сторожевая башня Стайта, которая выдаёт городу небольшое случайное количество предметов (алкоголь, инструменты, одежда, еда и прочее), очищая округу от бандитов, а город получает добычу. Нанимает 1-2 деревенских стражников. На карте можно построить только 1 башню Стайта.";	}
		
		{	String _name = "DSNewStythTower";		String _text = "Новая башня Стайта";	}
		{	String _name = "DSNewStythTowerLwr";		String _text = "новая башня Стайта";	}
		{	String _name = "DSNewStythTowerTip";		String _text = "Новая башня Стайта, обновлённая башня Стайта чуть большего размера, эта сторожевая башня выдаёт городу больше случайных предметов (алкоголь, инструменты, одежда, еда, драгоценности и прочее), очищая округу от бандитов, а город получает добычу. Нанимает 2-3 деревенских стражников. На карте можно построить только 1 новую башню Стайта.";	}
		
		{	String _name = "ProfessionVillageGuard";		String _text = "Деревенский стражник";	}
		{	String _name = "ProfessionVillageGuardTip";		String _text = "Деревенский стражник нанимается, чтобы служить и защищать город. Он работает на сторожевых башнях. Принято считать, что смертность среди них выше, чем в других профессиях.";	}
		{	String _name = "ProfessionVillageGuardDeath";		String _text = "умер от тяжёлых ран, защищая город от бандитов.";	}
		
		
