		{	String _name = "UpStoneHouseTip";		String _text = "Получите благословение святой Белль. Благословенный каменный дом больше не страдает от пожаров и торнадо. Для перестройки этого здания нужна Слеза святой Белль. Слезу святой Белль можно получить, разводя кур святой Белль.";	}
		{	String _name = "UpChapel";		String _text = "Благословенная церковь";	}
		{	String _name = "UpChapelLwr";		String _text = "Благословенная церковь";	}
		{	String _name = "UpChapelTip";		String _text = "Получите благословение святой Белль и Душу печального дождя. Благословенная церковь больше не страдает от пожаров и торнадо, а её вместимость удваивается. Для перестройки этого здания нужна Слеза святой Белль. Душа печального дождя усиливает функции здания. Слезу святой Белль можно получить, разводя кур святой Белль. Душу печального дождя можно получить, раскапывая могилы, но сначала нужно снести надгробие.";	}
