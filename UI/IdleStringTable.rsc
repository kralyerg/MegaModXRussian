		{	String _name = "Huoshan";		String _text = "[IC] Св. Вулкано-Астор Яо";	}
		{	String _name = "HuoshanLwr";		String _text = "[IC] Св. Вулкано-Астор Яо";	}
		{	String _name = "HuoshanTip";		String _text = "Континент древних времён. Выбирайте лучшую местность с большим количеством равнин. Поскольку поселение находится рядом со святым Вулканом, люди здесь живут до 60 лет, а дети рождаются у них в возрасте от 10 до 50 лет; кроме того, люди здесь быстрее и работоспособнее, поэтому не принимайте беженцев. Игра начинается по соседству со святым Вулканом, и святой Вулкан может благословить проклятый инструмент, сделав его священным (им можно пользоваться вечно).";	}
		{	String _name = "Dachengbao";		String _text = "Огромный замок";	}
