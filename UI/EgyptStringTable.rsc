	// ------------ New Egypt Starting Conditions ---------------------------
		{	String _name = "EgyptEasyName";		String _text = "Египет - Лёгкий";	}
		{	String _name = "EgyptEasyDesc";		String _text = "Вы попадаете на местность, где растут только пальмы и тропические деревья. В начале игры в Вашем распоряжении 6 семей. Жители уже построили 6 деревянных домов, амбар и склад, где есть значительные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и садов, а также стадо животных.";	}

