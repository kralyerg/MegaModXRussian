		{	String _name = "HardName";		String _text = "Трудно";	}
		{	String _name = "HardDesc";		String _text = "В начале игры в распоряжении имеется 4 семьи. В телеге предоставлено маленькое количество одежды, пищи, дров и орудий. Семена не предоставляются.";	}

		{	String _name = "MediumName";		String _text = "Средне";	}
		{	String _name = "MediumDesc";		String _text = "В начале игры в распоряжении имеется 5 семей. Предоставляется среднее количество одежды, пищи, дров, строительных материалов и орудий. Построены амбар и склад. Доступны случайные семена для полей и садов.";	}

		{	String _name = "EasyName";		String _text = "Легко";	}
		{	String _name = "EasyDesc";		String _text = "В начале игры в вашем распоряжении 6 семей. Предоставляется большое количество одежды, пищи, дров, строительных материалов и орудий. Построены 6 деревянных домов, амбар, склад. Доступны случайные семена для полей и садов, а также 6 шт. случайного вида домашних животных.";	}

		{	String _name = "DSSVEasyCropsName";		String _text = "Лёгкие культуры [DSSV]";	}
		{	String _name = "DSSVEasyCropsDesc";		String _text = "Лёгкая игра со всеми семенами полевых культур. Начинается с шести семей. 1600 еды, 30 одежды, 30 инструментов, 220 дров, 120 брёвен, 50 камня, 30 железа. Амбар DSSV уже построен. ДОМОВ НЕТ. Скота нет.";	}
		
		{	String _name = "DSSVEasyOrchName";		String _text = "Лёгкие сады [DSSV]";	}
		{	String _name = "DSSVEasyOrchDesc";		String _text = "Лёгкая игра со всеми семенами садовых деревьев. Начинается с шести семей. 1600 еды, 30 одежды, 30 инструментов, 220 дров, 120 брёвен, 50 камня, 30 железа. Амбар DSSV уже построен. ДОМОВ НЕТ. Скота нет.";	}
		
		{	String _name = "DSSVEasyFarmersName";		String _text = "Лёгкие фермеры [DSSV]";	}
		{	String _name = "DSSVEasyFarmersDesc";		String _text = "Лёгкая игра с несколькими семенами для полей и садов и, возможно, одним-двумя большими стадами скота. Начинается с шести семей. 1600 еды, 30 одежды, 30 инструментов, 220 дров, 120 брёвен, 50 камня, 30 железа. Амбар DSSV уже построен. ДОМОВ НЕТ.";	}

		{	String _name = "DSSVEasyAnimalsName";		String _text = "Лёгкие скотоводы [DSSV]";	}
		{	String _name = "DSSVEasyAnimalsDesc";		String _text = "Лёгкая игра с большей частью видов скота. Начинается с шести семей. 1600 еды, 30 одежды, 30 инструментов, 220 дров, 120 брёвен, 50 камня, 30 железа. Амбар DSSV уже построен. ДОМОВ НЕТ. Семян нет.";	}
		
		{	String _name = "DSSVEasyName";		String _text = "Легко [DSSV]";	}
		{	String _name = "DSSVEasyDesc";		String _text = "Лёгкая игра начинается с шести семей. 2400 еды, 50 инструментов, 50 одежды, 400 дров, 150 брёвен, 70 камня, 50 железа. Дома и склады DSSV уже построены. Доступны до 2 семян полевых культур и 2 семян садовых деревьев, а также 1 стадо скота.";	}
																
		{	String _name = "DSSVMediumName";		String _text = "Средне [DSSV]";	}
		{	String _name = "DSSVMediumDesc";		String _text = "Средняя игра начинается с пяти семей. 1600 еды, 30 одежды, 30 инструментов, 220 дров, 120 брёвен, 50 камня, 30 железа. Амбар DSSV уже построен. Доступны до 2 семян полевых культур и 1 семя садовых деревьев. Скота нет.";	}
																
		{	String _name = "DSSVHardName";		String _text = "Трудно [DSSV]";	}
		{	String _name = "DSSVHardDesc";		String _text = "Трудная игра начинается с четырёх семей. Телега с 750 еды, 10 одежды, 10 инструментов, 100 дров. Семян и скота нет.";	}
	
		{	String _name = "DSSVStrandedSeedsName";		String _text = "Выжившие с семенами [DSSV]";	}
		{	String _name = "DSSVStrandedSeedsDesc";		String _text = "Игра на выживание начинается с одной семьи, оказавшейся в изгнании посреди дикой местности. Оба взрослых образованы. Выдана телега с 300 еды, 3 одежды, 3 инструментами, 2 кожи и 20 дров. Есть небольшое количество семян. Скота нет.";	}
																	
		{	String _name = "DSSVStrandedName";		String _text = "Выживание [DSSV]";	}
		{	String _name = "DSSVStrandedDesc";		String _text = "Игра на выживание начинается с одной семьи, оказавшейся в изгнании посреди дикой местности. Оба взрослых образованы. Выдана телега с 300 еды, 3 одежды, 3 инструментами, 2 кожи и 20 дров. Семян и скота нет.";	}
	
		{	String _name = "DSSVStrandedHardName";		String _text = "Выживание: трудно [DSSV]";	}
		{	String _name = "DSSVStrandedHardDesc";		String _text = "Трудная игра на выживание начинается с двух семей, оказавшихся в изгнании посреди дикой местности. Взрослые образованы. Выдана телега с 300 еды, 3 одежды, 3 инструментами, 2 кожи и 20 дров. Семян и скота нет.";	}
	
		{	String _name = "DSSVStrandedHarderName";		String _text = "Выживание: ещё труднее [DSSV]";	}
		{	String _name = "DSSVStrandedHarderDesc";		String _text = "Очень трудная игра на выживание начинается с двух семей, оказавшихся в изгнании посреди дикой местности без запасов. Взрослые образованы. Семян и скота нет.";	}
	
	
	
