		{	String _name = "DSSVHospitalTip";		String _text = "Деревенская больница - место, куда приходят больные горожане, чтобы их лечил врач. Постройте базовую больницу; после постройки её можно улучшить кнопкой в окне здания. Для постройки нужно 144 труда.";	}
		{	String _name = "HospitalUpgrade1Tip";		String _text = "Улучшение деревенской больницы: вместимость 45 пациентов, работают 1-2 врача, добавлено новое крыло, снаружи каменная стена и небольшой сад. Для постройки нужно 55 труда.";	}
				
		
