		{	String _name = "CCMediumPlus";		String _text = "[CC] Средне+";	}
		{	String _name = "CCMediumPlusDesc";		String _text = "В начале игры в Вашем распоряжении 5 семей. Жители уже построили амбар и склад, на которых есть удовлетворительные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и садов, а также стадо животных.";	}
		
		{	String _name = "CCMissionary";		String _text = "[CC] Миссионерство";	}
		{	String _name = "CCMissionaryDesc";		String _text = "В начале игры в Вашем распоряжении 3 семьи, 2 из которых необразованные. Жители уже построили 2 дома, приходской дом и склад. В телеге, с которой они пришли есть скудные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и садов, а также стадо животных.";	}

