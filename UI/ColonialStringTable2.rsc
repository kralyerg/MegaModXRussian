		{	String _name = "CCAdamEve";		String _text = "[CC] Адам и Ева";	}
		{	String _name = "CCAdamEveDesc";		String _text = "В начале игре в Вашем распоряжении 2 человека. В телеге, с которой они пришли, есть скудные запасы пищи, дров, одежды и орудий, однако ни скот, ни семена они с собой не прихватили. Рекомендуется опытным игрокам.";	}

		{	String _name = "CCSilkRoad";		String _text = "[CC] Шёлковый путь (Легко)";	}
		{	String _name = "CCSilkRoadDesc";		String _text = "Начните производство шёлка с помощью построенных фермы шелкопрядов и ткацкой мастерской! В начале игры в Вашем распоряжении 6 семей. Жители уже построили 6 деревянных домов, амбар, склад, ферму шелкопрядов, ткацкую мастерскую и выделили область для сада. В амбаре и на складе есть значительные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и семена белой шелковицы для сада.";	}
		
		{	String _name = "CCSilkRoadMed";		String _text = "[CC] Шёлковый путь (Средне)";	}
		{	String _name = "CCSilkRoadMedDesc";		String _text = "Начните производство шёлка с помощью построенных фермы шелкопрядов и ткацкой мастерской! В начале игры в Вашем распоряжении 5 семей. Жители уже построили амбар, склад, ферма шелкопрядов, ткацкая мастерская и выделили область для сада. В амбаре и на складе есть удовлетворительные запасы одежды, пищи, дров, строительных материалов и орудий. Кроме того, жители прихватили какие-то семена для полей и семена белой шелковицы для сада.";	}
		
		{	String _name = "CCMine";		String _text = "[CC] Шахта";	}
