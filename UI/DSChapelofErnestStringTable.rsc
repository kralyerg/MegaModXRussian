		{	String _name = "DSChapelofErnestLwr";		String _text = "часовня святого Эрнеста";	}
		{	String _name = "DSChapelofErnestTip";		String _text = "Постройте часовню святого Эрнеста. Для проведения служб необходим священник. Часовня даёт горожанам место для встреч и молитв и приносит духовное счастье до 201 человека, включая священника. Размер 7x10 клеток. Для строительства требуется 155 ед. труда. На карте можно построить только одну часовню святого Эрнеста.";	}
		
		{	String _name = "DSChapelofErnestUITxt01";		String _text = "часовня святого Эрнеста";	}
		{	String _name = "DSChapelofErnestUITxt02";		String _text = "место для встреч и молитв, вмещает до 201 горожанина.";	}
		
