		{	String _name = "DSStoneBridgeMenuTip";		String _text = "DS Каменный мост. Модульный мост с жильём, складами, производством и услугами.";	}
		
		{	String _name = "DSNormalStoneBridgeL";		String _text = "Каменный мост, левая часть";	}
		{	String _name = "DSNormalStoneBridgeLLwr";		String _text = "каменный мост, левая часть";	}
		{	String _name = "DSNormalStoneBridgeLTip";		String _text = "левая сторона обычного строительного моста, размещается от берега до берега. Если карта ориентирована на север, этот мост будет слева при пересечении с севера на юг. При направлении с востока на запад этот мост будет сверху, то есть с северной стороны. Этот мост не включает концевые пандусы и лестницы, их нужно строить отдельно. Для строительства требуется 5 ед. труда на клетку";	}
		
		{	String _name = "DSNormalStoneBridgeR";		String _text = "Каменный мост, правая часть";	}
		{	String _name = "DSNormalStoneBridgeRLwr";		String _text = "каменный мост, правая часть";	}
		{	String _name = "DSNormalStoneBridgeRTip";		String _text = "правая сторона обычного строительного моста, размещается от берега до берега. Если карта ориентирована на север, этот мост будет справа при пересечении с севера на юг. При направлении с востока на запад этот мост будет снизу, то есть с южной стороны. Этот мост не включает концевые пандусы и лестницы, их нужно строить отдельно. Для строительства требуется 5 ед. труда на клетку";	}
		
		
