		{	String _name = "NMT30StorageBarnNorm";		String _text = "Обычный амбар";	}
		{	String _name = "NMT30StorageBarnNormLwr";		String _text = "обычный амбар";	}
		{	String _name = "NMT30StorageBarnNormTip";		String _text = "Обычный амбар используется для хранения товаров: пищи, одежды, текстиля и инструментов. Размер: 5x8. Цена: 48 брёвен, 16 камней. Вместимость: 10000. Принимает: съедобное, инструменты, травы, одежду, текстиль, зерно, овощи, фрукты, мясо, утварь, метизы, ткани, ценности, прочее. Советы: это точно такой же амбар, как в игровой панели складов.";	}

		{	String _name = "NMT30StorageBarnMed";		String _text = "Средний амбар";	}
		{	String _name = "NMT30StorageBarnMedLwr";		String _text = "средний амбар";	}
		{	String _name = "NMT30StorageBarnMedTip";		String _text = "Средний амбар используется для хранения товаров: пищи, одежды, текстиля и инструментов. Размер: 4x6. Цена: 32 бревна, 12 камней. Вместимость: 6000. Принимает: съедобное, инструменты, травы, одежду, текстиль, зерно, овощи, фрукты, мясо, утварь, метизы, ткани, ценности, прочее. Советы: это уменьшенная версия обычного амбара. Он дешевле и среднего размера, поэтому вместимость у него средняя.";	}

