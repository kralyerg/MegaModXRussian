		{	String _name = "LittleHouseToolbarTip";		String _text = "Откройте эту панель, чтобы выбрать варианты цветных маленьких домов. Советы: это набор из первого этажа и особого 2-го этажа, который ставится сверху на первый для второй семьи. В доме будет жить 5 человек, эффективность обогрева 80%. 12 разных цветов. Нажмите F, чтобы сменить цвет.";	}

		{	String _name = "LittleHouse01";		String _text = "Маленький дом";	}
