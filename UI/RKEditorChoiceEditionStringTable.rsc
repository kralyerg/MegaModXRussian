		{	String _name = "NMT30Foundry";		String _text = "Литейная";	}
		{	String _name = "NMT30FoundryLWR";		String _text = "литейной";	}
		{	String _name = "NMT30FoundryTip";		String _text = "Литейная это рабочая площадка, где можно переплавлять всё. Размер: 8x8 клеток. Цена: 24 бревна, 64 камня, 18 железа, 32 древесного угля. Может создать: 1-2 железа, меди, серебра или золота за работу. Работники: кузнецы (1-2). Советы: литейная позволяет переплавить всё, что есть в игре, и эффективнее простых кузниц.";	}

		{	String _name = "NMT30JewelMaker";		String _text = "Ювелир";	}
		{	String _name = "NMT30JewelMakerLWR";		String _text = "ювелир";	}
		{	String _name = "NMT30JewelMakerTip";		String _text = "Ювелир берёт драгоценные металлы и самоцветы и делает очень ценные кольца, ожерелья и украшения. Размер: 6x6 клеток. Цена: 8 брёвен, 24 доски, 16 камней, 18 кирпичей, 6 стекла. Может сделать: украшения из ограненных самоцветов и золота/серебра, много рецептов. Работники: рабочий (1). Советы: для огранки самоцветов нужен огранщик, а когда их ценность определена, из них можно делать серебряные или золотые изделия. Каждый рецепт даёт больше одного предмета за раз. Однако отсутствие образования плохо сказывается на этом здании. Список рецептов слишком длинный, чтобы приводить его здесь.";	}

		{	String _name = "NMT30GemCutter";		String _text = "Огранщик самоцветов";	}
		{	String _name = "NMT30GemCutterLWR";		String _text = "огранщик самоцветов";	}
		{	String _name = "NMT30GemCutterTip";		String _text = "Огранщик берёт самоцветы, огранивает их и определяет их качество и ценность. Размер: 6x6 клеток. Цена: 8 брёвен, 24 доски, 16 камней, 18 кирпичей, 6 стекла. Может сделать: аметист (ценность 60), топаз (ценность 80), изумруд (ценность 250), сапфир (ценность 300), рубин (ценность 400), алмаз (ценность 1000). Работники: рабочий (1). Советы: необработанные самоцветы можно получить только в случайном карьере. Разумеется, более ценные камни встречаются гораздо реже обычных.";	}

		{	String _name = "NMT30CandleMaker";		String _text = "Свечник";	}
		{	String _name = "NMT30CandleMakerLWR";		String _text = "свечник";	}
		{	String _name = "NMT30CandleMakerTip";		String _text = "Свечник делает свечи из пчелиного воска. Размер: 6x6 клеток. Цена: 12 брёвен, 24 доски, 18 камней, 24 кирпича, 12 стекла. Может сделать: 3-4 свечи из 16 воска за работу. Работники: рабочий (1). Советы: свеча стоит 8. Свечи нужны, чтобы улучшать и возобновлять истощённые шахты и каменоломни.";	}

		{	String _name = "NMT30MineUpgradeTip";		String _text = "Улучшите и обновите эту шахту или каменоломню до следующего, более глубокого уровня, чтобы продолжать добывать ресурсы, даже когда запасы истощены. Для этого понадобятся дополнительные материалы, например свечи.";	}

		{	String _name = "RKGardenWallsGreenHouse";		String _text = "Теплица";	}
		{	String _name = "RKGardenWallsGreenHouseLwr";		String _text = "теплица";	}
		{	String _name = "RKGardenWallsGreenHouseTip";		String _text = "Теплица — самый мощный источник пищи в этом моде. Размер: 5x7 клеток. Цена: 20 досок, 20 камней, 48 стёкол. Производит: все виды овощей в игре и некоторые мелкие плодовые растения, количество варьируется от 16-24 до 20-28. Работники: 1 ботаник. Советы: теплице требуется (2) удобрения и (2) воды за каждый рабочий цикл. (Лучший источник удобрений — конюшня, также сильно помогут пастбища с животными. Воду дают колодец или водонапорная башня).";	}

		{	String _name = "RKGardenWallsStables";		String _text = "Конюшня";	}
		{	String _name = "RKGardenWallsStablesLwr";		String _text = "конюшня";	}
		{	String _name = "RKGardenWallsStablesTip";		String _text = "Конюшня — лучший источник удобрений в игре. Размер: 9x6 клеток. Цена: 20 досок, 40 камней. Производит: 3-5 удобрений (цена 2) из 2 кормовой соломы и 2 воды за рабочий цикл. Работники: 1-2 конюха. Советы: нужен хороший источник кормовой соломы — её можно получать при расчистке земли или от кормовой фермы, а воду — из колодца или водонапорной башни. Удобрения используются в теплицах (самый мощный источник пищи на одну клетку).";	}

		{	String _name = "RKGardenWallsWell";		String _text = "Колодец";	}
		{	String _name = "RKGardenWallsWellLwr";		String _text = "колодец";	}
		{	String _name = "RKGardenWallsWellTip";		String _text = "Колодец — хороший источник свежей воды. Размер: 1x1 клетка (3x3 с дорогами). Цена: 4 доски, 24 камня. Производит: 12-15 воды (цена 1) за рабочий цикл. Работники: 1 рабочий. Советы: этот колодец НЕЛЬЗЯ использовать для тушения пожаров. Воду он даёт медленнее, чем водонапорная башня. Вода — это пища без питательных веществ (без пищевых флагов), она нужна во многих производствах: конюшнях, теплицах, парфюмерных мастерских, аптеках...";	}

		{	String _name = "RKGardenWallsFodderFarmers";		String _text = "Кормовая ферма";	}
		{	String _name = "RKGardenWallsFodderFarmersLwr";		String _text = "кормовая ферма";	}
		{	String _name = "RKGardenWallsFodderFarmersTip";		String _text = "Кормовая ферма сажает траву и собирает кормовую солому, когда трава полностью вырастает (вместо деревьев). Размер: 5x6 клеток. Цена: 32 доски, 4 камня. Производит: 3-4 кормовой соломы с каждого убранного участка травы. Радиус: 26 клеток. Работники: 1-3 лесоруба. Советы: работает точно так же, как домик лесоруба, но сажает траву. Сначала им придётся расчистить всё в своём радиусе: помогут убрать все деревья и все руды. После этого они посадят участок травы. Трава должна вырасти, и когда она созреет, её соберут. Корм также можно использовать для изготовления вязанок дров (дрова).";	}

		{	String _name = "RKGardenWallsFlorist";		String _text = "Флорист";	}
		{	String _name = "RKGardenWallsFloristLwr";		String _text = "флорист";	}
		{	String _name = "RKGardenWallsFloristTip";		String _text = "Флорист бродит по округе и собирает цветы. Размер: 5x6 клеток. Цена: 32 доски, 4 камня. Производит: 3-5 цветков с каждого убранного участка цветов. Радиус: 32. Работники: 1 собиратель. Советы: флорист действует точно так же, как собиратель, но ищет цветы и саженцы. Его не стоит ставить рядом со связкой лесоруб-собиратель (очень плохо), он создан для работы в паре с кормовой фермой. На траве появляется множество цветов. Внимание: цветы они не сажают.";	}

		{	String _name = "RKGardenWallsPerfumery";		String _text = "Парфюмерная мастерская";	}
		{	String _name = "RKGardenWallsPerfumeryLwr";		String _text = "парфюмерная мастерская";	}
		{	String _name = "RKGardenWallsPerfumeryTip";		String _text = "Парфюмерная мастерская делает духи из эссенции цветов. Размер: 5x5 клеток. Цена: 24 доски, 24 камня, 8 меди, 12 стеклянной посуды. Производит: 5-8 духов (цена 8) из 8 цветков, 2 воды и 1 стеклянной посуды за рабочий цикл. Работники: 1 рабочий. Советы. Один из лучших товаров на продажу, для которого нужно то, что можно найти повсюду, — цветы. Здание постоянно требует воду и стеклянную посуду. Воду дают колодец или водонапорная башня, а посуду — стеклодув.";	}

		{	String _name = "RKGardenWallsCustom5Barn";		String _text = "Кормовой амбар";	}
		{	String _name = "RKGardenWallsCustom5BarnLwr";		String _text = "кормовой амбар";	}
		{	String _name = "RKGardenWallsCustom5BarnTip";		String _text = "Кормовой амбар, в котором можно хранить только корм и всё, что относится к этой категории. Размер: 4x4 клетки. Цена: 12 брёвен, 28 кормовой соломы. Вместимость: 6000 ед. веса. Принимает: разные предметы. Советы: у корма флаг «Разное», поэтому здесь можно хранить все предметы с этим флагом. В здании 4x4 помещается намного больше видов предметов, чем на простом складе.";	}

		{	String _name = "RKGardenWallsTrash";		String _text = "Уничтожить";	}
		{	String _name = "RKGardenWallsTrashLwr";		String _text = "уничтожить";	}
		{	String _name = "RKGardenWallsTrashTip";		String _text = "Уничтожить этот предмет и снести его.";	}
		{	String _name = "RKGardenWallsTrashUpgradeTip";		String _text = "Уничтожить этот предмет и снести его.";	}

		{	String _name = "OldBarnPub";		String _text = "Старый амбар-паб";	}
		{	String _name = "OldBarnPubLWR";		String _text = "старый амбар-паб";	}
		{	String _name = "OldBarnPubTip";		String _text = "Старый амбар-паб — это амбар, переделанный в бар или паб. Здесь подают еду и напитки, а праздничная атмосфера повышает счастье. Размер: 6x6 клеток. Цена: 32 бревна, 16 камней. Счастье: развлечения. Радиус: 40 клеток. Работники: 1-3 пивовара. Советы: в этом здании используется новый флаг: «Потребление». Этот особый флаг помогает работать с алкоголем и действует так же. Пивовары берут мясо 2-го уровня, овощи и алкоголь и готовят 12-16 блюд (цена 1). Горожане берут блюда и получают от них счастье (точно как от эля), но это обходится намного дешевле.";	}


		{	String _name = "ClearWildFood";		String _text = "Собрать дикую пищу";	}
		{	String _name = "ClearWildFoodLwr";		String _text = "собрать дикую пищу";	}
		{	String _name = "ClearWildFoodTip";		String _text = "Собрать дикую пищу, появившуюся в выбранной области. Советы: дикая пища растёт на деревьях, а множество новых видов пищи появляется на цветах.";	}

		{	String _name = "ClearFodder";		String _text = "Собрать корм";	}
		{	String _name = "ClearFodderLwr";		String _text = "собрать корм";	}
		{	String _name = "ClearFodderTip";		String _text = "Собрать участки кормовой соломы в выбранной области. Советы: кормовая солома — это материал, который получают, срезая участки травы, видимые на земле. Корм можно использовать в конюшне, из него можно делать вязанки дров (дровосеки), его можно использовать как строительный материал (пасека, пастбище без ограды, кормовой амбар...). Каждый участок травы даёт 4-6 кормовой соломы (цена 1). Она хранится на строительном складе.";	}

		{	String _name = "ClearFlower";		String _text = "Собрать цветы";	}
		{	String _name = "ClearFlowerLwr";		String _text = "Собирать цветы";	}
		{	String _name = "ClearFlowerTip";		String _text = "Собрать цветы с участков в выбранной области. Советы: у цветов флаг «Разное». Каждый участок цветов даёт 3-5 цветков (цена 1). Убедитесь, что у вас есть амбары, принимающие разные предметы.";	}

		{	String _name = "ClearHerb";		String _text = "Сбор трав";	}
		{	String _name = "ClearHerbLwr";		String _text = "собрать лечебные травы";	}
		{	String _name = "ClearHerbTip";		String _text = "Жители соберут все травы в выбранной области.";	}

		{	String _name = "ClearCopper";		String _text = "Собрать медь";	}
		{	String _name = "ClearCopperLwr";		String _text = "собрать медь";	}
		{	String _name = "ClearCopperTip";		String _text = "Собрать всю медь и другие редкие минералы (золото и серебро) в выбранной области. Советы: медь используется для изготовления некоторых инструментов, а также как строительный материал. Медь и другие редкие руды относятся к минералам. Убедитесь, что у вас есть свободный склад материалов. Добывается 2-3 медной руды (цена 4), 1-2 серебряной руды (цена 11) или 1-2 золотой руды (цена 22). Убедитесь, что у вас есть свободный склад минералов для их хранения.";	}

		{	String _name = "ClearAlmostAll";		String _text = "Собрать почти всё";	}
		{	String _name = "ClearAlmostAllLwr";		String _text = "собрать почти всё";	}
		{	String _name = "ClearAlmostAllTip";		String _text = "Собрать все руды и камни в выбранной области. Советы: этот особый инструмент собирает все руды и все камни. Деревья, трава и другие ценные дикие растения остаются нетронутыми. Очень удобен, чтобы быстро расчистить все земли вокруг лесорубов.";	}

		{	String _name = "ClearFirewood";		String _text = "Сбор дров";	}
		{	String _name = "ClearFirewoodLwr";		String _text = "собрать валежник";	}
		{	String _name = "ClearFirewoodTip";		String _text = "Жители соберут все дрова в выбранной области.";	}

		{	String _name = "BostonHouse";		String _text = "Бостонский дом";	}
		{	String _name = "BostonHouseLwr";		String _text = "бостонский дом";	}
		{	String _name = "BostonHouseTip";		String _text = "Бостонские дома. Размер: 4x5. Каждый горожанин хотел бы жить в разноцветных бостонских домах. Стоимость: 48 брёвен.";	}

		{	String _name = "BostonHouse2";		String _text = "Бостонский дом 2";	}
		{	String _name = "BostonHouse2Lwr";		String _text = "бостонский дом 2";	}
		{	String _name = "BostonHouse2Tip";		String _text = "Бостонский дом 2 (другие текстуры и модели). Каждый горожанин мечтает жить в красочном бостонском доме. Размер: 4x5 клеток. Цена: 54 доски, 6 камней и 30 стёкол. Жители: 6 горожан. Эффективность обогрева: 108%. Моделей: 1. Цвета: 10 вариантов. Советы: нажмите F, чтобы сменить цвет.";	}

		{	String _name = "LittleHouseToolbar";		String _text = "Панель «Разноцветный домик»";	}
