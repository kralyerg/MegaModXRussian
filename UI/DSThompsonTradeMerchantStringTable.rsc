		{	String _name = "DSThompsonTradeMerchantTip";		String _text = "Торговец Томпсон, специализируется на ввозе фруктов, овощей и зерна. Торговцы принимают в оплату большинство товаров. Вместимость здания 40,000 веса. Площадь 8x8. Нанимает 1-13 торговцев. Для строительства требуется 144 ед. труда.";	}
		{	String _name = "DSThompsonTradeMerchantTxt0";		String _text = "Купец торгового порта Томпсона";	}
