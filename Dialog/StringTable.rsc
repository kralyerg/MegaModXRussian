		{	String _name = "ModResourceTitle";		String _text = "^jl^f1^c0Ресурсы^f0^n Ниже приведены ресурсы, содержащиеся в моде. Пункты, ^c1 выделенные оранжевым^c0 - файлы, конфликтующие с другим модом. Файлы данного мода будут загружены в любом случае. Пункты, ^c2 выделенные жёлтым^c0 - файлы, конфликтующие с другим модом. Файлы данного мода не будут загружены.";	}
	]
}


