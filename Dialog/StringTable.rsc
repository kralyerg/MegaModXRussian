		{	String _name = "ModCreatedBy";		String _text = "Автор: @0";	}
		{	String _name = "ModPath";		String _text = "Путь: @0";	}
		{	String _name = "ModPage";		String _text = "Страница:";	}
		{	String _name = "ModMissing";		String _text = "Следующий мод не найден или не может быть загружен.~n~n@0 [@1]~nСохранено с версией @2~n~nЗагрузка этого сохранения может привести к непредвиденным последствиям или сбоям. Всё равно загрузить сохранение?";	}
		{	String _name = "ModOutOfDate";		String _text = "Следующий мод устарел. Формат его данных может больше не поддерживаться.~n~n@0 [@1]~nСохранено с версией @2~n~nЗагрузка этого сохранения может привести к непредвиденным последствиям или сбоям. Всё равно загрузить сохранение?";	}
		{	String _name = "ModDifferentVersion";		String _text = "Версия следующего мода изменилась.~n~n@0 [@1]~nСохранено с версией @2~n~nВозможно, автор просто исправил ошибки или добавил новые функции, но загрузка этого сохранения всё равно может привести к непредвиденным последствиям или сбоям. Всё равно загрузить сохранение?";	}
		{	String _name = "ModChanged";		String _text = "Следующий мод отличается от того, каким он был при сохранении игры.~n~n@0 [@1]~nСохранено с версией @2~n~nВозможно, автор обновил мод, не изменив номер версии. Или мод с тем же названием на диске перезаписал этот мод. Загрузка этого сохранения может привести к непредвиденным последствиям или сбоям. Всё равно загрузить сохранение?";	}
		{	String _name = "ReloadMenu";		String _text = "Изменения в загруженных модах требуют перезагрузки меню.~n~nПрименить изменения и перезагрузить сейчас?";	}
		{	String _name = "ReloadGame";		String _text = "Изменения в загруженных модах требуют перезагрузки игры.~n~nПерезагрузка с другими модами в уже начатой игре может привести к нежелательным последствиям, например к непредвиденному поведению или сбоям.~n~nПрименить изменения и перезагрузить сейчас?";	}
		{	String _name = "ModConflict";		String _text = "Этот мод содержит ресурсы, конфликтующие с другим загруженным модом (выделен красным). Это может привести к непредвиденному поведению.~n~nБудут загружены ресурсы мода, расположенного выше в списке.";	}
		{	String _name = "ResumeGame";		String _text = "Вернуться в игру";	}
