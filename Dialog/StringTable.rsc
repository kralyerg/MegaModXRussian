	Entry _strings
	[
		{	String _name = "HardName";		String _text = "Трудно";	}
		{	String _name = "HardDesc";		String _text = "В начале игры в распоряжении имеется 4 семьи. В телеге предоставлено маленькое количество одежды, пищи, дров и инструментов. Семена не предоставляются.";	}
		{	String _name = "MediumName";		String _text = "Средне";	}
